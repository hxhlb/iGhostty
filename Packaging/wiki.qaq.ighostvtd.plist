<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>wiki.qaq.ighostvtd</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PREFIX@/usr/libexec/ighostvtd</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<!--
		The shell and every command it starts inherit the daemon's resource
		limits. launchd's default soft file-descriptor limit is too small for
		tools that scan many files concurrently, while the daemon itself can
		also own one PTY master per live session.
	-->
	<key>SoftResourceLimits</key>
	<dict>
		<key>NumberOfFiles</key>
		<integer>10240</integer>
	</dict>
	<!--
		Demand-launched, like the Mac agent. RunAtLoad starts it at boot,
		which is when it spawns ighostvtd-remote if remote access is on;
		MachServices brings it back whenever a client looks it up. It exits
		by itself once no client has been connected for a while and no
		session is held (IOSupervisor's idle exit), and that successful exit
		stands; a crash is restarted. With remote access on, the remote
		helper holds a connection for as long as it runs, so the daemon
		stays resident exactly as long as the switch is on.
	-->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Umask</key>
	<integer>18</integer>
	<key>MachServices</key>
	<dict>
		<key>wiki.qaq.ighostvt.service</key>
		<true/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DISABLE_TWEAKS</key>
		<string>1</string>
	</dict>
</dict>
</plist>
